__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets — never commit these
.env
*.env

# Runtime data directories (Docker volume mounts for local dev)
data/

# Log and report output files
*.log

# Test / coverage artefacts
.pytest_cache/
.coverage
htmlcov/

# Build artefacts
dist/
build/

# Custom plugins may contain API keys — they are gitignored by default.
# To track a specific plugin file, add it explicitly (e.g. !plugins/myplugin.py)
plugins/*.py
!plugins/example_plugin.py
!plugins/example_html_plugin.py
!plugins/thetvdb.py
!plugins/tmdb.py
