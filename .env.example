# m3 — Environment Variable Reference
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically at startup (python-dotenv).
# In Docker/Unraid, set these as container environment variables instead.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   python -m app.main --once

# =============================================================================
# REQUIRED
# =============================================================================

# URL of your Plex Media Server, e.g. http://192.168.1.10:32400
PLEX_URL=http://your-plex-ip:32400

# Your Plex authentication token (32-character string)
# Find it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=your-plex-token-here

# =============================================================================
# PATHS  (defaults work out-of-the-box for local dev; override for Docker)
# =============================================================================

# Comma-separated paths to scan for media files
# Local dev:  LIBRARY_PATHS=./media   (create this directory)
# Docker:     LIBRARY_PATHS=/media/Movies,/media/TV
LIBRARY_PATHS=./media

# Directory containing your drop-in plugin .py files
PLUGIN_DIR=./plugins

# Where run reports (JSON + txt) are written
REPORT_PATH=./reports

# Where rotating log files are written
LOG_PATH=./logs

# =============================================================================
# DEVELOPMENT SETTINGS  (change these for local dev, keep defaults in prod)
# =============================================================================

# Log level for application output
# Options: DEBUG, INFO, WARNING, ERROR
# Set to DEBUG for verbose output during local development
LOG_LEVEL=INFO

# Seconds to wait between plugin API calls
# Production default: 1.0 — set to 0 to disable throttling for local dev iteration
PLUGIN_RATE_LIMIT_SECS=1.0

# Maximum seconds one plugin.fetch() may block before timing out
# Default: 60
PLUGIN_FETCH_TIMEOUT_SECS=60

# Set to true to enable uvicorn --reload (auto-restarts on code changes)
# Only useful when running the web dashboard locally; do NOT use in production
DEBUG=false

# =============================================================================
# SCHEDULER
# =============================================================================

# Cron expression for when to run automatically (5-field standard cron)
# Default: 3:00 AM daily
# Set to a past time to test scheduled triggering, or use Run Now in the dashboard
RUN_SCHEDULE=0 3 * * *

# Timezone for the cron schedule (requires tzdata; use UTC if unsure)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Enable/disable the web dashboard (default: true)
WEB_ENABLED=true

# Port the web dashboard listens on (default: 8765)
WEB_PORT=8765

# Host the web dashboard binds to
# Use 127.0.0.1 to restrict to localhost only (more secure for local dev)
WEB_HOST=127.0.0.1

# Display name in the dashboard header and page title
APP_NAME=m3

# Webhook URL: m3 POSTs a JSON run summary here after each run
# Works with Apprise, Gotify, Pushover relay, or any HTTP endpoint
# Leave empty to disable
NOTIFY_URL=

# Minimum total errors (errors + scrape_errors + image_errors + plugin_errors) required before webhook fires
# 1 = only fire when errors occurred (default); 0 = fire after every run including clean ones
NOTIFY_MIN_ERRORS=1

# Comma-separated glob patterns to exclude from scanning
# Example: LIBRARY_EXCLUDE_PATTERNS=*.part,/media/incoming/**
LIBRARY_EXCLUDE_PATTERNS=

# How many days to keep log files (default: 30)
LOG_RETENTION_DAYS=30

# How many days to keep report files (default: 90)
REPORT_RETENTION_DAYS=90

# =============================================================================
# PLUGIN-SPECIFIC API KEYS  (add your own here)
# =============================================================================

# These are examples — replace with whatever your plugins need
# MYSITE_API_KEY=your-api-key-here
# OTHERSITE_API_KEY=your-other-api-key
